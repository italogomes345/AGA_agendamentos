DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=0000
DB_DATABASE=aga_agendamentos

# O aplicativo cria e atualiza o banco automaticamente ao iniciar.
AUTO_UPDATE_DATABASE=true

# Sessão
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
SESSION_HOURS=8
SESSION_COOKIE_SECURE=false

# Opcional: se ficar vazio, o primeiro administrador será criado pelo site.
ADMIN_NAME=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Retenção mínima dos registros enviados para a lixeira
RETENCAO_EXCLUIDOS_ANOS=5

# Opcional: envio real pelo WhatsApp da Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886
